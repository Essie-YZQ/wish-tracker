rules_version = '2';

// Server-side guard for Bloom Journal's closed 30-wish economy.
// Every write to a shared_state document is checked against the document as it
// would look AFTER the write. Any write leaving S + KK + Pool != 30 (or a
// negative / non-integer balance) is rejected by Firestore itself, no matter
// which client or app version sent it -- including stale tabs running old code.
service cloud.firestore {
  match /databases/{database}/documents {

    function validWishTotal(d) {
      return d.sBalance is int && d.kkBalance is int && d.poolBalance is int
        && d.sBalance >= 0 && d.kkBalance >= 0 && d.poolBalance >= 0
        && d.sBalance + d.kkBalance + d.poolBalance == 30;
    }

    // Every write must be stamped by current app code: clientVersion at least the
    // minimum below, and writeAt set to serverTimestamp() in THIS write. Old tabs
    // never send the stamp (a merge would keep the previous writeAt, which is not
    // equal to request.time), so they are locked out entirely. Raise the minimum
    // together with APP_VERSION in script.js when an old version must be blocked.
    function stampedByCurrentApp(d) {
      return d.clientVersion is int && d.clientVersion >= 28
        && d.writeAt == request.time;
    }

    match /shared_state/{docId} {
      allow read: if true;
      allow create, update: if validWishTotal(request.resource.data)
        && stampedByCurrentApp(request.resource.data);
      // The live document can never be deleted; scratch docs (rule checks) can.
      allow delete: if docId != 'main';
    }

    // The app uses no other collections; everything else is denied by default.
  }
}
